{
  "name": "@erniesg/struct",
  "version": "0.0.0",
  "description": "Source-neutral StructDocument codecs and deterministic document renderers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CONTRACT.md",
    "MIGRATION.md",
    "API.md",
    "API_MANIFEST.json",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./ordering": {
      "types": "./dist/ordering.d.ts",
      "import": "./dist/ordering.js"
    },
    "./receipt": {
      "types": "./dist/receipt.d.ts",
      "import": "./dist/receipt.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js"
    },
    "./renderers/xhtml": {
      "types": "./dist/renderers/xhtml.d.ts",
      "import": "./dist/renderers/xhtml.js"
    },
    "./renderers/epub": {
      "types": "./dist/renderers/epub.d.ts",
      "import": "./dist/renderers/epub.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/document/index.ts src/identity.ts src/ordering.ts src/receipt.ts src/recovery.ts src/renderers/xhtml.ts src/renderers/epub.ts --format esm --dts --clean",
    "test": "npm run test:layout-boundary && npm run test:layout && vitest run --exclude \"tests/layout-eval/**\"",
    "test:layout": "vitest run tests/layout-eval --exclude tests/layout-eval/layout-eval-boundary.test.ts",
    "test:layout-boundary": "node scripts/check-layout-eval-boundary.mjs && vitest run tests/layout-eval/layout-eval-boundary.test.ts",
    "test:layout-goldens": "node scripts/verify-layout-goldens.mjs",
    "test:package": "npm run build && node scripts/test-packed-consumer.mjs",
    "test:source-boundary": "node scripts/check-source-boundary.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "ajv": "8.20.0",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": ""
}
